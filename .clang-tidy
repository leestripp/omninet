---
# OmniNet clang-tidy configuration (v0.9.0 compiler migration)
#
# Usage: clang-tidy -p build <source> ...
#        cmake --build build --target clang_tidy

# Start from LLVM's default set; enable modern C++ checks.
# Disable checks that generate too much noise or don't apply to
# a C++23 codebase.
Checks: >
  -*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -modernize-use-scoped-lock,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -readability-identifier-length,
  -readability-isolate-declaration,
  -readability-function-cognitive-complexity,
  -readability-braces-around-statements

# Treat high-signal checks as errors.
WarningsAsErrors: 'clang-analyzer-*,cppcoreguidelines-init-variables,clang-analyzer-core.NullDereference,clang-analyzer-core.UndefinedBinaryOperatorResult'

# Apply to project headers only.
HeaderFilterRegex: '.*/src/.*'

# Use .clang-format if present.
FormatStyle: file